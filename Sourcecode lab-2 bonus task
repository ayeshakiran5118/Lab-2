#include <iostream>
using namespace std;

int main()
{
    int num;
    
    cout << "Enter a five-digit number: ";
    cin >> num;

    cout << num / 10000 << "   ";
    cout << (num / 1000) % 10 << "   ";
    cout << (num / 100) % 10 << "   ";
    cout << (num / 10) % 10 << "   ";
    cout << num % 10 << endl;

    return 0;
}
